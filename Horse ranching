import React, { useEffect, useState } from "react";

// Horse Breeder - Single-file React component
// - Tailwind CSS assumed available in the host app
// - Default export is the component
// - Features: stable of horses, select parents, breed, genetics (simple), persistent in localStorage

const COLORS = [
  "Bay",
  "Chestnut",
  "Black",
  "Grey",
  "Palomino",
  "Cream",
];

const PATTERNS = ["Solid", "Blaze", "Sock", "Pinto"];

function randInt(min, max) {
  return Math.floor(Math.random() * (max - min + 1)) + min;
}

function pick(array) {
  return array[Math.floor(Math.random() * array.length)];
}

function blendColor(c1, c2) {
  // Simple heuristic mixing: if the same -> return it, otherwise random pick with small chance of mutation
  if (c1 === c2) return c1;
  const mix = Math.random();
  if (mix < 0.45) return c1;
  if (mix < 0.9) return c2;
  // mutation
  return pick(COLORS);
}

function blendPattern(p1, p2) {
  if (p1 === p2) return p1;
  const mix = Math.random();
  return mix < 0.5 ? p1 : p2;
}

function makeId() {
  return Math.random().toString(36).slice(2, 9);
}

function createRandomHorse(overrides = {}) {
  const sex = Math.random() < 0.5 ? "M" : "F";
  const horse = {
    id: makeId(),
    name: overrides.name || `Horse_${Math.random().toString(36).slice(2,6)}`,
    generation: overrides.generation || 0,
    sex,
    color: overrides.color || pick(COLORS),
    pattern: overrides.pattern || pick(PATTERNS),
    traits: overrides.traits || {
      speed: randInt(40, 90),
      stamina: randInt(40, 90),
      temperament: randInt(30, 90),
    },
    bornAt: Date.now(),
    parents: overrides.parents || null,
  };
  return horse;
}

export default function HorseBreederApp() {
  const [stable, setStable] = useState([]);
  const [selectedA, setSelectedA] = useState(null);
  const [selectedB, setSelectedB] = useState(null);
  const [log, setLog] = useState([]);
  const [nameInput, setNameInput] = useState("");

  // load from localStorage
  useEffect(() => {
    const raw = localStorage.getItem("horse_stable_v1");
    if (raw) {
      try {
        setStable(JSON.parse(raw));
        addLog("Loaded stable from localStorage");
        return;
      } catch (e) {
        console.error("Failed to parse stable", e);
      }
    }
    // If empty, create starter herd
    const starters = [createRandomHorse({ name: "Apollo" }), createRandomHorse({ name: "Dawn" }), createRandomHorse({ name: "Comet" })];
    setStable(starters);
    addLog("Created starter stable (3 horses)");
  }, []);

  useEffect(() => {
    localStorage.setItem("horse_stable_v1", JSON.stringify(stable));
  }, [stable]);

  function addLog(text) {
    setLog((l) => [ `${new Date().toLocaleTimeString()} — ${text}`, ...l ].slice(0, 50));
  }

  function toggleSelect(id) {
    if (!selectedA || (selectedA && selectedB)) {
      setSelectedA(id);
      setSelectedB(null);
      return;
    }
    if (selectedA === id) {
      setSelectedA(null);
      return;
    }
    setSelectedB(id);
  }

  function breed() {
    if (!selectedA || !selectedB) {
      addLog("Select two parents first (one male + one female).");
      return;
    }
    const parentA = stable.find((h) => h.id === selectedA);
    const parentB = stable.find((h) => h.id === selectedB);
    if (!parentA || !parentB) {
      addLog("Selected parents are missing from stable.");
      return;
    }
    if (parentA.sex === parentB.sex) {
      addLog("Parents must be opposite sexes to breed.");
      return;
    }

    // Simple genetic combination
    const mother = parentA.sex === "F" ? parentA : parentB;
    const father = parentA.sex === "M" ? parentA : parentB;

    const childName = nameInput.trim() || `${mother.name}-${father.name}-${Math.random().toString(36).slice(2,4)}`;

    const child = {
      id: makeId(),
      name: childName,
      generation: Math.max(mother.generation, father.generation) + 1,
      sex: Math.random() < 0.5 ? "M" : "F",
      color: blendColor(mother.color, father.color),
      pattern: blendPattern(mother.pattern, father.pattern),
      traits: {
        speed: Math.max(20, Math.round((mother.traits.speed + father.traits.speed) / 2 + randInt(-5, 8))),
        stamina: Math.max(20, Math.round((mother.traits.stamina + father.traits.stamina) / 2 + randInt(-6, 6))),
        temperament: Math.max(10, Math.round((mother.traits.temperament + father.traits.temperament) / 2 + randInt(-8, 5))),
      },
      bornAt: Date.now(),
      parents: [mother.id, father.id],
    };

    // small chance for rare mutation boost
    if (Math.random() < 0.06) {
      const trait = pick(["speed", "stamina", "temperament"]);
      child.traits[trait] = Math.min(100, child.traits[trait] + randInt(5, 20));
      addLog(`${child.name} received a rare mutation (+${trait})!`);
    }

    setStable((s) => [child, ...s]);
    setSelectedA(null);
    setSelectedB(null);
    setNameInput("");
    addLog(`${child.name} (Gen ${child.generation}) born — ${child.sex} — ${child.color} (${child.pattern})`);
  }

  function addRandom() {
    const h = createRandomHorse();
    setStable((s) => [h, ...s]);
    addLog(`Added ${h.name} to stable`);
  }

  function removeHorse(id) {
    setStable((s) => s.filter((h) => h.id !== id));
    addLog(`Removed horse ${id} from stable`);
    if (selectedA === id) setSelectedA(null);
    if (selectedB === id) setSelectedB(null);
  }

  function exportStable() {
    const data = JSON.stringify(stable, null, 2);
    const blob = new Blob([data], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `stable-${new Date().toISOString().slice(0,10)}.json`;
    a.click();
    URL.revokeObjectURL(url);
    addLog("Exported stable to JSON");
  }

  function importStable(event) {
    const file = event.target.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (ev) => {
      try {
        const data = JSON.parse(ev.target.result);
        if (Array.isArray(data)) {
          setStable(data);
          addLog("Imported stable from file");
        } else {
          addLog("Invalid file format");
        }
      } catch (e) {
        addLog("Failed to import: invalid JSON");
      }
    };
    reader.readAsText(file);
  }

  function clearStable() {
    if (!confirm("Clear stable? This cannot be undone.")) return;
    setStable([]);
    addLog("Cleared stable");
  }

  function HorseCard({ horse }) {
    const selected = horse.id === selectedA || horse.id === selectedB;
    return (
      <div
        className={`border rounded-2xl p-3 shadow-sm hover:shadow-md transition relative ${selected ? "ring-4 ring-indigo-300" : ""}`}
      >
        <div className="flex items-start gap-3">
          <div className="w-20 h-20 flex items-center justify-center bg-gradient-to-br from-white to-gray-50 rounded-lg">
            <div className="text-3xl">🐎</div>
          </div>
          <div className="flex-1">
            <div className="flex items-center justify-between">
              <div>
                <div className="font-semibold">{horse.name}</div>
                <div className="text-sm text-gray-500">Gen {horse.generation} • {horse.sex === 'M' ? 'Stallion' : 'Mare'}</div>
              </div>
              <div className="text-xs text-gray-600">{horse.color} • {horse.pattern}</div>
            </div>
            <div className="mt-2 grid grid-cols-3 gap-2 text-sm">
              <Stat label="Speed" value={horse.traits.speed} />
              <Stat label="Stamina" value={horse.traits.stamina} />
              <Stat label="Temper" value={horse.traits.temperament} />
            </div>
          </div>
        </div>

        <div className="mt-3 flex items-center gap-2">
          <button
            onClick={() => toggleSelect(horse.id)}
            className="px-3 py-1 rounded-md bg-indigo-600 text-white text-sm"
          >
            {horse.id === selectedA || horse.id === selectedB ? "Selected" : "Select"}
          </button>
          <button onClick={() => removeHorse(horse.id)} className="px-3 py-1 rounded-md bg-red-50 text-red-600 text-sm">Remove</button>
          <div className="ml-auto text-xs text-gray-400">Born {new Date(horse.bornAt).toLocaleDateString()}</div>
        </div>
      </div>
    );
  }

  function Stat({ label, value }) {
    return (
      <div>
        <div className="text-xs text-gray-500">{label}</div>
        <div className="text-sm font-medium">{value}</div>
        <div className="h-2 bg-gray-100 rounded mt-1 overflow-hidden">
          <div style={{ width: `${Math.min(100, value)}%` }} className="h-full bg-gradient-to-r from-indigo-400 to-indigo-600" />
        </div>
      </div>
    );
  }

  function SelectedPreview() {
    const a = stable.find((h) => h.id === selectedA);
    const b = stable.find((h) => h.id === selectedB);
    return (
      <div className="p-3 border rounded-2xl">
        <div className="flex items-center gap-4">
          <div className="flex-1">
            <div className="text-sm text-gray-500">Parent A</div>
            {a ? <div className="font-semibold">{a.name} — {a.sex}</div> : <div className="text-gray-400">(pick parent A)</div>}
          </div>
          <div className="flex-1">
            <div className="text-sm text-gray-500">Parent B</div>
            {b ? <div className="font-semibold">{b.name} — {b.sex}</div> : <div className="text-gray-400">(pick parent B)</div>}
          </div>
        </div>

        <div className="mt-3 grid grid-cols-1 md:grid-cols-3 gap-2">
          <div className="col-span-1 md:col-span-2">
            <input value={nameInput} onChange={(e) => setNameInput(e.target.value)} placeholder="Offspring name (optional)" className="w-full p-2 rounded-md border" />
          </div>
          <div>
            <button onClick={breed} className="w-full p-2 rounded-md bg-green-600 text-white">Breed</button>
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className="p-6 max-w-6xl mx-auto">
      <div className="flex items-center justify-between mb-6">
        <h1 className="text-2xl font-bold">Horse Breeder</h1>
        <div className="flex items-center gap-2">
          <button onClick={addRandom} className="px-3 py-1 rounded-md bg-blue-600 text-white">Add Random</button>
          <button onClick={exportStable} className="px-3 py-1 rounded-md bg-yellow-50 text-yellow-700">Export</button>
          <label className="px-3 py-1 rounded-md bg-gray-50 text-gray-700 cursor-pointer">
            Import
            <input type="file" accept="application/json" onChange={importStable} className="hidden" />
          </label>
          <button onClick={clearStable} className="px-3 py-1 rounded-md bg-red-50 text-red-600">Clear</button>
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div className="lg:col-span-2 space-y-4">
          <SelectedPreview />

          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {stable.map((h) => (
              <HorseCard key={h.id} horse={h} />
            ))}
          </div>
        </div>

        <aside className="space-y-4">
          <div className="p-3 border rounded-2xl">
            <div className="flex items-center justify-between">
              <div className="font-semibold">Stable Stats</div>
              <div className="text-sm text-gray-500">{stable.length} horses</div>
            </div>
            <div className="mt-3 text-sm text-gray-600">
              Avg speed: {Math.round((stable.reduce((s, h) => s + (h.traits?.speed||0), 0) / Math.max(1, stable.length)))}
              <br />
              Avg stamina: {Math.round((stable.reduce((s, h) => s + (h.traits?.stamina||0), 0) / Math.max(1, stable.length)))}
            </div>
          </div>

          <div className="p-3 border rounded-2xl">
            <div className="font-semibold mb-2">Recent log</div>
            <div className="text-xs text-gray-600 space-y-2 max-h-48 overflow-auto">
              {log.map((l, i) => <div key={i}>{l}</div>)}
            </div>
          </div>

          <div className="p-3 border rounded-2xl">
            <div className="font-semibold mb-2">Help</div>
            <div className="text-sm text-gray-600 space-y-2">
              <div>• Select two parents (click "Select") — they must be opposite sexes.</div>
              <div>• Optionally give the foal a name, then click Breed.</div>
              <div>• Export your stable to share or import later.</div>
              <div>• Horses carry simple traits: speed, stamina, temperament.</div>
            </div>
          </div>
        </aside>
      </div>

      <div className="mt-6 text-xs text-gray-500">Tip: this component stores the stable in localStorage (key: horse_stable_v1).</div>
    </div>
  );
}


